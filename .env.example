# ─── HeyToolie (Next.js) environment ─────────────────────────────────────────
# Copy to .env.local for dev; set the same names in Vercel → Settings →
# Environment Variables (Production). NEXT_PUBLIC_* values end up in the
# browser bundle; everything else is server-only and must never be prefixed.
# Changing a Vercel variable needs a redeploy to take effect.

# ─── Site ────────────────────────────────────────────────────────────────────
# Magic-link redirects, push deep links, digest links. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://heytoolie.com

# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...    # publishable (or legacy anon) key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...             # secret (or legacy service_role) key — bypasses RLS

# ─── Limits ──────────────────────────────────────────────────────────────────
# Sign-up is locked by the allowed_emails table + auth hook (see RULES.md), not an env var.
DAILY_ITEM_CAP=50                                   # shared items per user per (SAST) day

# ─── Gemini ──────────────────────────────────────────────────────────────────
# aistudio.google.com → API key. Also set a hard budget cap in Google Cloud Billing.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_FAST=gemini-3.8-flash                  # videos, recipes, classify, picks (thinks: low)
GEMINI_MODEL_PRO=gemini-4-argon                     # explainers, lessons, diagrams, chat (thinks: medium)
GEMINI_EMBED_MODEL=gemini-embedding-001             # requested at 768 dims to match vector(768)

# ─── Council (OpenRouter) ────────────────────────────────────────────────────
# openrouter.ai → Keys. Set a credit limit on the key. Any OpenAI-compatible
# gateway works via the base URL. A session costs roughly $1–2.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Swap a seat's model (seats: chair, skeptic, builder, market, wildcard):
# COUNCIL_MODELS={"chair":"anthropic/claude-sonnet-5.5"}
COUNCIL_DAILY_CAP=5                                 # council sessions per user per 24 h

# ─── Background jobs (Inngest) ───────────────────────────────────────────────
# Production: install the Inngest integration from the Vercel Marketplace — it
# sets both keys and syncs /api/inngest on every deploy.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local only (never on Vercel): send jobs to `npm run dev:inngest` instead of the cloud.
# INNGEST_DEV=1

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate a pair with: npx web-push generate-vapid-keys
# Changing the pair orphans existing browser subscriptions; the app re-subscribes
# them on the next visit (components/enable-push.tsx).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Weekly digest ───────────────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/digest
# (Sundays 18:00 SAST, see vercel.json). Any long random string: openssl rand -hex 32
CRON_SECRET=
# Email fallback for the digest. Without a key the digest goes out by push only.
# RESEND_API_KEY=
# EMAIL_FROM=HeyToolie <hello@heytoolie.com>        # domain must be verified in Resend
# Signs digest tracking links. Optional: derived from the service-role key if unset.
# DIGEST_LINK_SECRET=

# ─── Diagrams ────────────────────────────────────────────────────────────────
# Mermaid → PNG renderer. Defaults to the free public instance.
# KROKI_URL=https://kroki.io
