# ─── HeyToolie (Next.js) environment ─────────────────────────────────────────
# Copy to .env.local for dev; set the same names in Vercel → Settings → Env Vars.
# NEXT_PUBLIC_* values end up in the browser bundle. Everything else is
# server-only (API routes, background jobs) and must never be prefixed.

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://heytoolie.com          # magic-link redirect + push deep links

# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # server only — bypasses RLS

# ─── Limits ──────────────────────────────────────────────────────────────────
# Sign-up is locked by the allowed_emails table (see RULES.md), not an env var.
DAILY_ITEM_CAP=50                                    # soft cap on shared items per user per day

# ─── Gemini ──────────────────────────────────────────────────────────────────
# aistudio.google.com → API key. Also set a hard budget cap in Google Cloud Billing.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_FAST=gemini-2.5-flash                   # classify, explain, recipe
GEMINI_MODEL_PRO=gemini-2.5-pro                      # lessons (Phase 3)
GEMINI_EMBED_MODEL=gemini-embedding-001              # requested at 768 dims to match vector(768)

# ─── Background jobs (Inngest) ───────────────────────────────────────────────
# app.inngest.com → your app → Keys. Not needed for `npx inngest-cli dev` locally.
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Reuse the existing keypair so current subscriptions keep working.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# ─── Email fallback (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=HeyToolie <hello@heytoolie.com>

# ─── Analytics (optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Public tools ────────────────────────────────────────────────────────────
PUBLIC_TOOL_DAILY_LIMIT=5                            # free /tools/recipe-extractor runs per visitor per day

# ─── Diagrams (Phase 2) ──────────────────────────────────────────────────────
# Mermaid → PNG renderer. Defaults to the free public instance; point at a
# self-hosted Kroki if it gets slow or rate-limited.
# KROKI_URL=https://kroki.io

# ─── Weekly digest (Phase 4) ─────────────────────────────────────────────────
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/digest.
# Set it in Vercel → Settings → Environment Variables; any long random string.
CRON_SECRET=
# Signs digest tracking links. Optional: derived from the service-role key if unset.
# DIGEST_LINK_SECRET=
